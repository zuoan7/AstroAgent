# AstroAgent 环境配置模板
# 复制此文件为 .env.local 并填写你的API密钥

# ========== 千问模型配置 ==========
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ========== NASA API 配置 ==========
NASA_API_KEY=your_nasa_api_key_here

# ========== 高德地图 API 配置 ==========
AMAP_API_KEY=your_amap_api_key_here

# ========== Tavily 联网搜索 API ==========
TAVILY_API_KEY=your_tavily_api_key_here  # 可选

# ========== 模型选择 ==========
# 可选值: qwen-max, qwen-plus, qwen-turbo, qwen-vl-plus
MODEL_NAME=qwen-max
EMBEDDING_MODEL_NAME=text-embedding-v2
VISION_MODEL_NAME=qwen-vl-plus
SPEECH_MODEL_NAME=paraformer-realtime-v2

# ========== 服务端口配置 ==========
API_HOST=0.0.0.0
API_PORT=8002
MCP_PORT=8001

# ========== 开发环境配置 ==========
# ENVIRONMENT=development  # development, test, production
# DEBUG=true
