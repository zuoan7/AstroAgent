          {"role": "assistant", "content": "噪声 08：流星雨要远离灯光。"},
          {"role": "user", "content": "噪声 09：相机曝光参数 ISO 1600 120 秒。"},
          {"role": "assistant", "content": "噪声 10：曝光参数要看跟踪精度。"},
          {"role": "user", "content": "噪声 11：月面晨昏线也想拍。"},
          {"role": "assistant", "content": "噪声 12：月面摄影看视宁度。"},
          {"role": "user", "content": "噪声 13：上海天气多云那天不适合。"},
          {"role": "assistant", "content": "噪声 14：上海多云会影响深空。"},
          {"role": "user", "content": "噪声 15：北京天气上次晴。"},
          {"role": "assistant", "content": "噪声 16：北京晴天仍要看高度。"},
          {"role": "user", "content": "噪声 17：双子座流星雨峰值我忘了。"},
          {"role": "assistant", "content": "噪声 18：双子座通常夜间较稳定。"},
          {"role": "user", "content": "噪声 19：我还有 135mm 镜头。"},
          {"role": "assistant", "content": "噪声 20：135mm 可拍大目标。"},
          {"role": "user", "content": "噪声 21：金星高度低时不好看。"},
          {"role": "assistant", "content": "噪声 22：金星低空受大气影响。"},
          {"role": "user", "content": "噪声 23：天文台活动要照顾儿童安全。"},
          {"role": "assistant", "content": "噪声 24：儿童活动需要低风险流程。"},
          {"role": "user", "content": "噪声 25：彗星也许要双筒镜。"},
          {"role": "assistant", "content": "噪声 26：彗星需要暗空。"},
          {"role": "user", "content": "噪声 27：火星冲日颜色会更明显。"},
          {"role": "assistant", "content": "噪声 28：火星需要高倍率。"},
          {"role": "user", "content": "现在只说 M42，我在北京今晚想看猎户座大星云。"},
          {"role": "assistant", "content": "好的，当前焦点是北京的 M42 观测。"},
          {"role": "user", "content": "如果高度足够，我就带 80mm 折射镜。"},
          {"role": "assistant", "content": "80mm 折射镜适合 M42，关键是高度和天气。"},
          {"role": "user", "content": "你查到后给我一句话建议。"},
          {"role": "assistant", "content": "M42 在北京高度足够，前面的 80mm 折射镜建议成立。"}
        ],
        "tool_calls": [
          {
            "tool_name": "astrophotography-calculator",
            "tool_input": "{\"target\":\"M31\",\"location\":\"上海\"}",
            "raw_output": "{\"target\":\"M31\",\"location\":\"上海\",\"exposure\":\"90 秒\",\"wrong_target\":\"M31 wrong evidence\"}",
            "success": true
          },
          {
            "tool_name": "celestial-position",
            "tool_input": "{\"object\":\"M42\",\"location\":\"北京\"}",
            "raw_output": "{\"object\":\"M42\",\"location\":\"北京\",\"altitude\":\"55 度\",\"rise_time\":\"19:42\",\"suitability\":\"适合观测\",\"equipment\":\"80mm 折射镜\",\"advice\":\"前面的建议成立。\"}",
            "success": true
          }
        ],
        "task_state_patch": {
          "current_goal": "确认北京 M42 观测建议是否仍成立",
          "active_constraints": ["长历史噪声", "只关注 M42", "设备 80mm 折射镜"],
          "next_action": "基于 M42 高度复核建议"
        }
      },
      "followup_query": "所以前面那个建议还成立吗？",
      "paraphrase_queries": ["那前面那套说法还行吗？", "这种条件下 80mm 还合适吗？", "刚才那个目标现在看还稳吗？"],
      "expected_relevant_keywords": ["M42", "北京", "55 度", "80mm 折射镜"],
      "expected_tool_names": ["celestial-position"],
      "expected_tool_keywords": ["M42", "北京", "55 度"],
      "irrelevant_keywords": ["土星冲日", "近地小行星", "英仙座流星雨", "M31"],
      "wrong_tool_keywords": ["M31", "上海", "90 秒"],
      "requires_tool_evidence": true,
      "noise_heavy": true
