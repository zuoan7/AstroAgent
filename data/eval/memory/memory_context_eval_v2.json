{
  "dataset_id": "memory_context_eval_v2",
  "description": "Stress evaluation set for AstroAgent short-term memory context construction. It intentionally includes vague follow-ups, long noisy histories, conflicting tool evidence, stale evidence, paraphrases, and small token budgets.",
  "scenarios": [
    {
      "scenario_id": "vague_weather_beijing_001",
      "description": "模糊追问北京观测天气，历史中混入上海天气和 M42 位置工具结果",
      "session_id": "eval_v2_session_001",
      "setup": {
        "messages": [
          {"role": "user", "content": "我周末可能想看土星，先不用细查。"},
          {"role": "assistant", "content": "可以之后再查土星高度和天气。"},
          {"role": "user", "content": "之前拍 M31 的曝光参数我也想复盘。"},
          {"role": "assistant", "content": "M31 摄影参数可以单独评估。"},
          {"role": "user", "content": "近地小行星那个话题先放一放。"},
          {"role": "assistant", "content": "近地小行星暂不处理。"},
          {"role": "user", "content": "现在回到北京今晚目视观测，帮我查一下条件。"},
          {"role": "assistant", "content": "我会重点看北京云量、湿度和透明度。"},
          {"role": "user", "content": "如果云很少，我主要看月球和亮星。"},
          {"role": "assistant", "content": "月球和亮星对透明度要求中等，但云量仍然关键。"},
          {"role": "user", "content": "查完后先别长篇解释。"},
          {"role": "assistant", "content": "北京结果显示条件偏好，可以继续观测。"}
        ],
        "tool_calls": [
          {
            "tool_name": "weather-lookup",
            "tool_input": "{\"city\":\"上海\",\"date\":\"tonight\"}",
            "raw_output": "{\"city\":\"上海\",\"status\":\"多云\",\"cloud\":\"云量 72%\",\"suitability\":\"不适合\",\"reason\":\"低云较多，透明度差，wrong city evidence for Beijing question.\"}",
            "success": true
          },
          {
            "tool_name": "celestial-position",
            "tool_input": "{\"object\":\"M42\",\"location\":\"北京\"}",
            "raw_output": "{\"object\":\"M42\",\"location\":\"北京\",\"altitude\":\"38 度\",\"suitability\":\"可观测\",\"note\":\"位置条件尚可，但这不是天气证据。\"}",
            "success": true
          },
          {
            "tool_name": "weather-lookup",
            "tool_input": "{\"city\":\"北京\",\"date\":\"tonight\"}",
            "raw_output": "{\"city\":\"北京\",\"status\":\"晴\",\"cloud\":\"云量 8%\",\"humidity\":\"湿度 35%\",\"suitability\":\"适合观测\",\"transparency\":\"良好\",\"observing_tip\":\"月球和亮星都可以看，北京今晚条件算好。\"}",
            "success": true
          }
        ],
        "task_state_patch": {
          "current_goal": "判断北京今晚是否还能目视观测",
          "active_constraints": ["模糊追问", "需要排除上海天气", "目标是月球和亮星"],
          "next_action": "基于北京最新天气给出结论"
        }
      },
      "followup_query": "那这种情况还能看吗？",
      "paraphrase_queries": ["刚才那个条件算好吗？", "所以还能出去看一会儿吗？", "前面说的情况影响观测吗？", "这个结果是不是还可以？"],
      "expected_relevant_keywords": ["北京", "晴", "云量 8%", "适合观测"],
      "expected_tool_names": ["weather-lookup"],
      "expected_tool_keywords": ["北京", "晴", "云量 8%"],
      "irrelevant_keywords": ["土星", "近地小行星", "M31 摄影参数"],
      "wrong_tool_keywords": ["上海", "云量 72%", "M42"],
      "requires_tool_evidence": true,
      "noise_heavy": false
    },
    {
      "scenario_id": "long_noise_m42_advice_002",
